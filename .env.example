# Copia este archivo a .env  ->  cp .env.example .env
# docker compose lo lee automáticamente.

# --- Asistente de IA -------------------------------------------------------
# OpenAI (por defecto). Consigue la clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opcional: forzar modelo (por defecto gpt-4o-mini)
# ASSISTANT_MODEL=gpt-4o-mini

# Alternativa si algún día usas Anthropic en vez de OpenAI:
# ANTHROPIC_API_KEY=

# --- Seguridad / red -----------------------------------------------------
# Cadena larga y aleatoria en cualquier despliegue real:
JWT_SECRET=sensolab-local-dev-secret

# Orígenes permitidos por CORS (deja * en local):
CORS_ORIGIN=*
